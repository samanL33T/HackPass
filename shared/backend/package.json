{
  "name": "hackpass-backend",
  "version": "1.0.0",
  "description": "HackPass backend - vault sync, license validation, policy, messages.",
  "type": "module",
  "scripts": {
    "start":         "bun run src/server.ts",
    "build:windows": "bun build --compile --minify --sourcemap=none --target=bun-windows-x64  src/server.ts --outfile hackpass-server-windows-x64.exe",
    "build:darwin":  "bun build --compile --minify --sourcemap=none --target=bun-darwin-arm64 src/server.ts --outfile hackpass-server-darwin-arm64",
    "build:linux":   "bun build --compile --minify --sourcemap=none --target=bun-linux-x64    src/server.ts --outfile hackpass-server-linux-x64"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
